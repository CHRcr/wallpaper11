{
  "name": "wallpaper11-host",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "icons": "powershell -ExecutionPolicy Bypass -File ../tools/make-icons.ps1",
    "serve": "node ../tools/dev-server.js",
    "media:dev": "node ../tools/prepare-dev-media.js",
    "predev": "npm run icons && npm run media:dev",
    "dev": "tauri dev",
    "prebuild": "npm run icons",
    "build": "tauri build --no-bundle",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
